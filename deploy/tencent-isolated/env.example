# Install as /etc/yuwatang-reservation.env, root:root 600. Not a shell script.
SPRING_PROFILES_ACTIVE=production
APP_MODE=production
PORT=8790
BIND_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8791
MANAGEMENT_BIND_ADDRESS=127.0.0.1
APP_DATA_DIR=/var/lib/yuwatang-reservation
PUBLIC_URL=https://booking.yuhetangtcm.com

# Dedicated MySQL 8.4 LTS container; never the existing host MySQL on port 3306.
# MariaDB here is the JDBC driver name; the server is MySQL.
DB_URL=jdbc:mariadb://127.0.0.1:3307/yuwatang_reservation?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=disable&connectTimeout=3000&socketTimeout=10000
DB_USERNAME=yuwatang_app
DB_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD=
DB_POOL_SIZE=8
DB_POOL_IDLE=2
HTTP_THREADS=64
HTTP_CONNECTIONS=1024
MAX_ACTIVE_REQUESTS=48
MAX_ACTIVE_WRITES=8
MAX_ACTIVE_LOGINS=2
MAX_ACTIVE_SESSIONS=4
MAX_ACTIVE_IMPORTS=1

WECHAT_APP_ID=wxce054e18303efb8a
WECHAT_APP_SECRET=
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
WECHAT_MESSAGE_ALLOW_PLAINTEXT=false
CUSTOMER_TEMPLATE_ID=JVNwa7kEPHJUORhAJKvqdnYbazd7uNmkJPJ4ImucDlQ
CUSTOMER_REMINDER_TEMPLATE_ID=VaYcGAZpoIhzLoojppTX8LVbcS1Ftq33WBPTYwsfkFY
CUSTOMER_TEMPLATE_MAPPING='{"name1":"customerName","date2":"time","thing3":"serviceName","thing4":"storeName","phrase5":"status"}'
CUSTOMER_REMINDER_TEMPLATE_MAPPING='{"thing31":"customerName","time2":"time","thing7":"serviceName","thing8":"storeName","phrase11":"status"}'

SERVICE_APP_ID=
SERVICE_APP_SECRET=
SERVICE_TEMPLATE_ID=
SERVICE_OAUTH_URL=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_STAFF_TEMPLATE_ID=
SMS_CUSTOMER_TEMPLATE_ID=
SMS_REGION=ap-guangzhou
PMS_ENABLED=false
