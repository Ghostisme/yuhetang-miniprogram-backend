# Include this whole file at Nginx http context, e.g. /etc/nginx/conf.d/.
# For an existing Nginx, use its actual http include directory from nginx -T.
# Install the matching certificate and key first; preserve all other sites.
limit_req_zone $binary_remote_addr zone=yuhetang_booking_login:1m rate=5r/s;

server {
    listen 80;
    server_name booking.yuhetangtcm.com;
    location / { return 301 https://booking.yuhetangtcm.com$request_uri; }
}

server {
    listen 443 ssl;
    server_name booking.yuhetangtcm.com;
    ssl_certificate /etc/yuwatang-reservation/tls/fullchain.pem;
    ssl_certificate_key /etc/yuwatang-reservation/tls/privkey.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 10m;
    server_tokens off;
    client_max_body_size 6m;

    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }

    location = /api/admin/login {
        limit_req zone=yuhetang_booking_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 25s;
    }
}
