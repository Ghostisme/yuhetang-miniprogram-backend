# 示例配置；请勿将正式密钥提交到代码仓库。
# 本地脚本读取 .env.local，正式部署通过进程环境变量传入。
APP_MODE=local
PORT=8790
BIND_ADDRESS=127.0.0.1
# 正式环境设为 production，并使用至少32位随机JWT密钥和独立初始管理员密码。
JWT_SECRET=
ADMIN_PASSWORD=
# 留空时使用本项目 data/reservation.mv.db；MySQL请提前创建专属空库及专属用户。
# DB_URL=jdbc:mysql://127.0.0.1:3306/yuwatang_reservation?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# DB_USERNAME=yuwatang_app
# DB_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 小程序消息推送：HTTPS /api/wechat/customer-service，使用安全模式。
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
WECHAT_MESSAGE_ALLOW_PLAINTEXT=false
CUSTOMER_TEMPLATE_ID=
CUSTOMER_REMINDER_TEMPLATE_ID=
# JSON defaults initialize missing mappings; later HQ edits take precedence.
CUSTOMER_TEMPLATE_MAPPING=
CUSTOMER_REMINDER_TEMPLATE_MAPPING=
SERVICE_APP_ID=
SERVICE_APP_SECRET=
SERVICE_TEMPLATE_ID=
# 例如 https://booking.example.cn，需与服务号网页授权域名一致。
PUBLIC_URL=
PMS_ENABLED=false
PMS_API_KEY=
# 腾讯云短信：凭证仅放服务端；各门店在“消息通知”中单独开启。
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_STAFF_TEMPLATE_ID=
SMS_CUSTOMER_TEMPLATE_ID=
SMS_REGION=ap-guangzhou
# 参数必须与审核通过的模板占位顺序一致。
SMS_STAFF_PARAMS=storeName,time,eventLabel
SMS_CUSTOMER_PARAMS=storeName,time,status
